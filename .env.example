GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview
PORT=5173
# Simulator/browser on the same machine:
# EXPO_PUBLIC_OCR_PROXY_URL=http://localhost:5173/api/ocr

# Physical phone on the same Wi-Fi as this computer:
EXPO_PUBLIC_OCR_PROXY_URL=http://192.168.0.90:5173/api/ocr

# Firebase — create a project at https://console.firebase.google.com
# Enable Email/Password auth and Firestore database, then paste values below.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=