{
  "name": "personal-finance-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prototype": "node server.js",
    "typecheck": "tsc --noEmit",
